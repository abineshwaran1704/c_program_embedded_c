#include<stdio.h>
int main() {
    for(int i=0;i<=8;i++) {
        for(int j=0;j<=8-i;j++) { 
            printf(" ");

        }
        for(int j=0;j<2*i-1;j++) {
            printf("*");
        }
        printf("\n");
    }
    for(int i =8;i>0;--i) {
        for(int j= 0;j<=8-i;j++) {
            printf(" ");
        }
            for(int j =2*i-1;j>0;j--) {
                printf("*");

            }
            printf("\n");

        
    }
}
